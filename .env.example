# MongoDB Atlas (FREE tier)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-spend-audit?retryWrites=true&w=majority

# AI - Gemini FREE API
GEMINI_API_KEY=your_gemini_api_key_here

# OR OpenRouter FREE models (fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Resend EMAIL (FREE tier - 100 emails/day)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
CONTACT_EMAIL=hello@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SpendScan AI

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60000
